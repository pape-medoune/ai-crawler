# ============================================================
#  AI Test Platform - Variables d'environnement (template)
#  Copier ce fichier en `.env` et remplir les valeurs reelles.
#  NE JAMAIS COMMITER le fichier `.env` rempli.
# ============================================================

# --- Anthropic Claude (obligatoire pour le crawler IA) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Modele Claude (defaut : claude-sonnet-4-5 - voir https://docs.anthropic.com/en/docs/about-claude/models)
CLAUDE_MODEL=claude-sonnet-4-5
# Budget max tokens par appel (defaut 2048)
CLAUDE_MAX_TOKENS=2048

# --- Cible a tester ---
# URL que le crawler IA doit explorer et que K6 doit charger.
# En local avec Docker host : http://host.docker.internal:3000
TARGET_URL=http://host.docker.internal:3000
# Objectif en langage naturel pour le crawler
CRAWLER_GOAL=Verifier que la page d'accueil fonctionne et que la navigation principale est accessible
# Nombre max d'etapes pour le crawler (defaut 10)
CRAWLER_MAX_STEPS=10

# --- Navigateur ---
HEADLESS=1
# 1=on (toutes), retain-on-failure, off
VIDEO_MODE=retain-on-failure
SCREENSHOT_MODE=only-on-failure
TRACE_MODE=retain-on-failure

# --- SMTP (optionnel - si vide, le mail de rapport n'est pas envoye) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# --- Artefacts CI (pour le lien dans l'email) ---
# GitLab : ${CI_PROJECT_URL}/-/jobs/${CI_JOB_ID}/artifacts/raw
# GitHub : https://github.com/<org>/<repo>/actions/runs/${GITHUB_RUN_ID}/artifacts
ARTIFACT_BASE_URL=https://gitlab.com/-/artifacts
CI_PIPELINE_ID=local
CI_JOB_ID=local

# --- K6 (charge & scalabilite) ---
K6_MAX_VUS=200
# Format "duree:target,..." (defaut progressif 0 -> 50 -> 100 -> 200 -> 0)
K6_RAMP_STAGES=30s:50,1m:100,30s:200,30s:0
K6_P95_THRESHOLD_MS=2000
K6_ERROR_RATE_THRESHOLD=0.01
